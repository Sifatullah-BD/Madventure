###############################################################
# .env.example – Copy to .env and fill in real values
# NEVER commit .env to git!
###############################################################

# ── Supabase (Frontend) ─────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_DEMO_AUTH=false
# Development only: set true to inspect protected dashboards without real login

# ── Payment Gateway (Frontend – only store ID for display) ──
VITE_SSLCOMMERZ_STORE_ID=your_store_id_here
VITE_SSLCOMMERZ_STORE_PASSWORD=your_store_password_here

# ── Firebase (FCM push notifications) ───────────────────────
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# ── Gemini AI ────────────────────────────────────────────────
VITE_GEMINI_API_KEY=your_gemini_api_key_here

###############################################################
# Supabase Edge Function Secrets
# Set via: supabase secrets set KEY=VALUE
# Or Dashboard → Project Settings → Edge Functions → Secrets
###############################################################

# SUPABASE_URL=            (auto-injected by Supabase runtime)
# SUPABASE_ANON_KEY=       (auto-injected)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SSLCommerz (backend secrets – never expose in frontend!)
# SSLCOMMERZ_STORE_ID=testbox          <- use 'testbox' for sandbox
# SSLCOMMERZ_STORE_PASSWORD=testbox    <- use 'testpass' for sandbox
# SSLCOMMERZ_LIVE=0                    <- set to 1 for production gateway
# PAYMENT_MOCK=0                       <- set to 1 to force mock flow (dev only)
# DEV_PAYMENT_SECRET=your_dev_secret_here  <- must match token in callback mock

# Email
# RESEND_API_KEY=your_resend_api_key_here

# Frontend URL (for CORS and redirects)
# FRONTEND_URL=http://localhost:5173

